<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.web.controller.biz.meeting.mapper.MeetingParticipantMapper">

    <select id="selectUserIdsByMeetingId" parameterType="Long" resultType="Long">
        SELECT user_id FROM meeting_participant WHERE meeting_id = #{meetingId}
    </select>

    <delete id="deleteByMeetingId" parameterType="Long">
        DELETE FROM meeting_participant WHERE meeting_id = #{meetingId}
    </delete>

    <insert id="insertMeetingParticipants">
        INSERT INTO meeting_participant (meeting_id, user_id) VALUES
        <foreach collection="userIds" item="userId" separator=",">
            (#{meetingId}, #{userId})
        </foreach>
    </insert>

</mapper>