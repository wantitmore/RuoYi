<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.web.controller.biz.sixcheck.mapper.SixCheckDeductDetailMapper">

    <resultMap id="BaseResultMap" type="com.ruoyi.web.controller.biz.sixcheck.domain.SixCheckDeductDetail">
        <id column="id" property="id"/>
        <result column="kpi_score_id" property="kpiScoreId"/>
        <result column="deduct_info" property="deductInfo"/>
        <result column="status" property="status"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
        <result column="six_check_record_id" property="sixCheckRecordId"/>
        <result column="deduct_score" property="deductScore"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, kpi_score_id, deduct_info, status, create_by, create_time, update_by, update_time, six_check_record_id, deduct_score
    </sql>

    <insert id="insert" parameterType="SixCheckDeductDetail" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO six_check_deduct_detail (
            six_check_record_id, kpi_score_id, deduct_score, deduct_info, status, create_by, create_time
        ) VALUES (
            #{sixCheckRecordId}, #{kpiScoreId}, #{deductScore}, #{deductInfo}, 1, #{createBy}, NOW()
        )
    </insert>

    <update id="update" parameterType="SixCheckDeductDetail">
        UPDATE six_check_deduct_detail
        <set>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = NOW()
        </set>
        WHERE id = #{id}
    </update>

    <select id="selectById" parameterType="java.lang.Long" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM six_check_deduct_detail
        WHERE id = #{id}
    </select>

    <select id="selectList" parameterType="SixCheckDeductDetail" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM six_check_deduct_detail
        <where>
            <if test="kpiScoreId != null">AND kpi_score_id = #{kpiScoreId}</if>
            <if test="status != null">AND status = #{status}</if>
            <if test="sixCheckRecordId != null">AND six_check_record_id = #{sixCheckRecordId}</if>
        </where>
        ORDER BY id DESC
    </select>

</mapper>