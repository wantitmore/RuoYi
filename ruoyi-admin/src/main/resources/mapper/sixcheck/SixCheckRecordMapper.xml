<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.web.controller.biz.sixcheck.mapper.SixCheckRecordMapper">
    
    <resultMap type="SixCheckRecord" id="SixCheckRecordResult">
        <result property="id"    column="id"    />
        <result property="itemId"    column="item_id"    />
        <result property="recordValue"    column="record_value"    />
        <result property="batchNo"    column="batch_no"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectSixCheckRecordVo">
        select id, item_id, record_value, batch_no, create_by, create_time, update_by, update_time from six_check_record
    </sql>

    <select id="selectSixCheckRecordList" parameterType="SixCheckRecord" resultMap="SixCheckRecordResult">
        <include refid="selectSixCheckRecordVo"/>
        <where>  
            <if test="itemId != null "> and item_id = #{itemId}</if>
            <if test="recordValue != null  and recordValue != ''"> and record_value = #{recordValue}</if>
            <if test="batchNo != null  and batchNo != ''"> and batch_no = #{batchNo}</if>
            <if test="deptId != null">AND dept_id = #{deptId}</if>
        </where>
    </select>
    
    <select id="selectSixCheckRecordById" parameterType="Long" resultMap="SixCheckRecordResult">
        <include refid="selectSixCheckRecordVo"/>
        where id = #{id}
    </select>

    <insert id="insertSixCheckRecord" parameterType="SixCheckRecord" useGeneratedKeys="true" keyProperty="id">
        insert into six_check_record
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="itemId != null">item_id,</if>
            <if test="recordValue != null">record_value,</if>
            <if test="batchNo != null and batchNo != ''">batch_no,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="deptId != null">dept_id,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="itemId != null">#{itemId},</if>
            <if test="recordValue != null">#{recordValue},</if>
            <if test="batchNo != null and batchNo != ''">#{batchNo},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="deptId != null">#{deptId},</if>
         </trim>
    </insert>

    <update id="updateSixCheckRecord" parameterType="SixCheckRecord">
        update six_check_record
        <trim prefix="SET" suffixOverrides=",">
            <if test="itemId != null">item_id = #{itemId},</if>
            <if test="recordValue != null">record_value = #{recordValue},</if>
            <if test="batchNo != null and batchNo != ''">batch_no = #{batchNo},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteSixCheckRecordById" parameterType="Long">
        delete from six_check_record where id = #{id}
    </delete>

    <delete id="deleteSixCheckRecordByIds" parameterType="String">
        delete from six_check_record where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>